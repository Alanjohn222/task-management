{
  "info": {
    "name": "Task Management API",
    "description": "Run in order using two unused email addresses and local test passwords. Login saves the bearer tokens and Create saves the ID of the disposable task that the run deletes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5080"
    },
    {
      "key": "emailA",
      "value": ""
    },
    {
      "key": "passwordA",
      "value": ""
    },
    {
      "key": "emailB",
      "value": ""
    },
    {
      "key": "passwordB",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "API health",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Database health",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/health/database"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Database is ready\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register A",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{{credentialsBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = pm.variables.get(\"emailA\");",
              "const password = pm.variables.get(\"passwordA\");",
              "pm.variables.set(\"credentialsBody\", JSON.stringify({ name: \"Test User A\", email, password }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login A",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{{credentialsBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = pm.variables.get(\"emailA\");",
              "const password = pm.variables.get(\"passwordA\");",
              "pm.variables.set(\"credentialsBody\", JSON.stringify({ email, password }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.unset(\"tokenA\");",
              "if (pm.response.code === 200) {",
              "    const token = pm.response.json().accessToken;",
              "    pm.test(\"Access token issued\", () => pm.expect(token).to.be.a(\"string\").and.not.empty);",
              "    pm.collectionVariables.set(\"tokenA\", token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Register B",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{{credentialsBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = pm.variables.get(\"emailB\");",
              "const password = pm.variables.get(\"passwordB\");",
              "pm.variables.set(\"credentialsBody\", JSON.stringify({ name: \"Test User B\", email, password }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login B",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{{credentialsBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = pm.variables.get(\"emailB\");",
              "const password = pm.variables.get(\"passwordB\");",
              "pm.variables.set(\"credentialsBody\", JSON.stringify({ email, password }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.unset(\"tokenB\");",
              "if (pm.response.code === 200) {",
              "    const token = pm.response.json().accessToken;",
              "    pm.test(\"Access token issued\", () => pm.expect(token).to.be.a(\"string\").and.not.empty);",
              "    pm.collectionVariables.set(\"tokenB\", token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify identity as A",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create task as A",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman collection task\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.unset(\"taskId\");",
              "if (pm.response.code === 201) {",
              "    const task = pm.response.json();",
              "    pm.collectionVariables.set(\"taskId\", task.id);",
              "    pm.test(\"Location points to the new task\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/tasks/\" + task.id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List tasks as A",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"List includes the new task\", () => {",
              "    pm.expect(pm.response.json().items.some(task => task.id === pm.collectionVariables.get(\"taskId\"))).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Fetch task as A",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update task as A",
      "request": {
        "method": "PUT",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Postman collection task\",\n  \"description\": null,\n  \"isCompleted\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Task is complete\", () => pm.expect(pm.response.json().isCompleted).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "List tasks as B",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenB}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"List excludes the task owned by A\", () => {",
              "    pm.expect(pm.response.json().items.some(task => task.id === pm.collectionVariables.get(\"taskId\"))).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Fetch task as B",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenB}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update task as B",
      "request": {
        "method": "PUT",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenB}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Forbidden edit\",\n  \"description\": null,\n  \"isCompleted\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete task as B",
      "request": {
        "method": "DELETE",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenB}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm task survived as A",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Task still has the owner\u2019s update\", () => pm.expect(pm.response.json().title).to.eql(\"Updated Postman collection task\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "List without a token",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create with an invalid title",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \" \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
